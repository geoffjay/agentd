{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Filter metrics by experiment label. Compare dispatches, costs, and outcomes across experiments.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Experiment Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agentd-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Dispatches (Selected Experiment)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "agentd-prometheus" }, "expr": "sum(experiment_dispatches_total{job=\"agentd-orchestrator\",experiment=~\"$experiment\"})", "instant": true, "legendFormat": "" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "agentd-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Failed Dispatches (Selected Experiment)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "agentd-prometheus" }, "expr": "sum(experiment_dispatches_total{job=\"agentd-orchestrator\",experiment=~\"$experiment\",status=\"failed\"})", "instant": true, "legendFormat": "" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "agentd-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Cost Accumulated (Selected Experiment)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "agentd-prometheus" }, "expr": "sum(experiment_cost_usd_total{job=\"agentd-orchestrator\",experiment=~\"$experiment\"})", "instant": true, "legendFormat": "" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "agentd-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Avg Dispatch Duration (Selected Experiment)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "agentd-prometheus" }, "expr": "histogram_quantile(0.50, sum(rate(experiment_dispatch_duration_seconds_bucket{job=\"agentd-orchestrator\",experiment=~\"$experiment\"}[5m])) by (le))", "instant": true, "legendFormat": "" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Dispatch Rate Over Time",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agentd-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "title": "Dispatch Rate by Experiment",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "agentd-prometheus" }, "expr": "rate(experiment_dispatches_total{job=\"agentd-orchestrator\",experiment=~\"$experiment\"}[5m])", "legendFormat": "{{experiment}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "agentd-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": { "legend": { "calcs": ["mean", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "title": "Cost Accumulation by Experiment",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "agentd-prometheus" }, "expr": "increase(experiment_cost_usd_total{job=\"agentd-orchestrator\",experiment=~\"$experiment\"}[5m])", "legendFormat": "{{experiment}} cost" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Experiment Comparison",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agentd-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "cost_usd" }, "properties": [{ "id": "unit", "value": "currencyUSD" }] },
          { "matcher": { "id": "byName", "options": "avg_duration_s" }, "properties": [{ "id": "unit", "value": "s" }] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 12,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [] },
      "title": "All Experiments — Side-by-Side Comparison",
      "type": "table",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "agentd-prometheus" }, "expr": "sum by (experiment) (experiment_dispatches_total{job=\"agentd-orchestrator\"})", "legendFormat": "", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "experiment": "Experiment", "Value": "dispatches" } } }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["agentd", "experiments"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "agentd-prometheus" },
        "definition": "label_values(experiment_dispatches_total{job=\"agentd-orchestrator\"}, experiment)",
        "hide": 0,
        "includeAll": true,
        "label": "Experiment",
        "multi": true,
        "name": "experiment",
        "options": [],
        "query": { "query": "label_values(experiment_dispatches_total{job=\"agentd-orchestrator\"}, experiment)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "agentd — Experiment Tracking",
  "uid": "agentd-experiment-tracking",
  "version": 1
}
