[Unit]
Description=agentd UI service
After=network.target agentd-orchestrator.service agentd-notify.service agentd-ask.service
Wants=network.target

[Service]
Type=simple
User=agentd
Group=agentd
EnvironmentFile=/etc/agentd/agentd.conf
Environment=AGENTD_PORT=7009
ExecStart=/usr/bin/agentd-ui
Restart=on-failure
RestartSec=5
StateDirectory=agentd
LogsDirectory=agentd

[Install]
WantedBy=multi-user.target
