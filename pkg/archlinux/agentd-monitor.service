[Unit]
Description=agentd monitor service
After=network.target
Wants=network.target

[Service]
Type=simple
User=agentd
Group=agentd
EnvironmentFile=/etc/agentd/agentd.conf
Environment=AGENTD_PORT=7003
ExecStart=/usr/bin/agentd-monitor
Restart=on-failure
RestartSec=5
StateDirectory=agentd
LogsDirectory=agentd

[Install]
WantedBy=multi-user.target
